rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Notes Collection: Everyone can read, Faculty/Admin can write
    match /notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Assignments Collection: Everyone can read, Faculty can create & delete
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Submissions Collection: Students can create, Faculty can grade & update
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Users Collection: User management & faculty profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
